              "is pool scout up"
            ],
            "examples": [
              "get_pools_health"
            ]
          }
        ]
      }
    ]
  },
  "entries": [
    {
      "name": "get_pools",
      "title": "Pool overview",
      "summary": "Venue, pair, fee tier, age, TVL and the price the reserves imply. The one call that identifies a pool.",
      "path": "pools",
      "keywords": [
        "chain",
        "overview",
        "venue",
        "pair",
        "fee",
        "tier",
        "age",
        "tvl",
        "price",
        "reserve",
        "imply",
        "what is this pool",
        "dex",
        "fee tier",
        "created"
      ],
      "input": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "solana",
              "ethereum",
              "base",
              "bsc"
            ],
            "description": "Chain slug."
          },
          "pool": {
            "type": "string",
            "minLength": 20,
            "maxLength": 64,
            "description": "Pool address (the pair contract, or the AMM account on Solana)."
          }
        },
        "required": [
          "chain",
          "pool"
        ]
      },
      "call": {
        "type": "http",
        "method": "GET",
        "urlTemplate": "/api/public/pools/{chain}/{pool}"
      },
      "risk": "read",
      "description": "The one call that identifies a pool. Every other resource under this path assumes you already know which pool you mean.",
      "returns": "An object with pool, chain, dex, version, pair, feeTierBps, createdAt, tvlUsd, priceUsd.",
      "relations": [
        {
          "type": "pairs_with",
          "target": "get_pools_health",
          "reason": "same resource: pools",
          "weight": 0.3
        },
        {
          "type": "pairs_with",
          "target": "get_pools_search",
          "reason": "same resource: pools",
          "weight": 0.3
        },
        {
          "type": "narrower",
          "target": "get_pools_liquidity",
          "reason": "just the depth, plus whether the LP is locked or burned"
        },
        {
          "type": "narrower",
          "target": "get_pools_volume",
          "reason": "just the activity over a window"
        }
      ],
      "examples": [
        {
          "input": {
            "chain": "solana",
            "pool": "7NhFfdRq2M9aVzZpN4xKpT7YQ2cEUzdmJ9bH6sWkLPaB"
          },
          "note": "a deep, long-lived pool — useful to see a healthy result"
        }
      ]
    },
    {
      "name": "get_pools_apr",
      "title": "Yield for providers",
      "summary": "Fee and incentive APR a liquidity provider would earn, annualised from the last seven days. An estimate, not a promise.",
      "path": "pools",
      "keywords": [
        "apr",
        "chain",
        "fee",
        "incentive",
        "yield",
        "liquidity",
        "provider",
        "earn",
        "apy",
        "providing liquidity",
        "what would i earn providing liquidity",
        "farming",
        "returns",
        "what would i make",
        "incentives",
        "rewards"
      ],
      "input": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "solana",
              "ethereum",
              "base",
              "bsc"
            ],
            "description": "Chain slug."
          },
          "pool": {
            "type": "string",
            "minLength": 20,
            "maxLength": 64,
            "description": "Pool address (the pair contract, or the AMM account on Solana)."
          }
        },
        "required": [
          "chain",
          "pool"
        ]
      },
      "call": {
        "type": "http",
        "method": "GET",
        "urlTemplate": "/api/public/pools/{chain}/{pool}/apr"
      },
      "risk": "read",
      "description": "Annualised from the last seven days of fees against current TVL. An estimate, not a promise: it assumes volume and TVL stay where they are.",
      "returns": "An object with feeApr, incentiveApr, totalApr, basis.",
      "relations": [

    {
      "name": "get_pools_health",
      "title": "Health check",
      "summary": "Whether the pool data surface and its indexer are answering. Public: it needs no key.",
      "path": "pools/status",
      "keywords": [
        "health",
        "data",
        "surface",
        "check",
        "status",
        "up",
        "down",
        "is the service up"
      ],
      "input": {
        "type": "object",
        "properties": {}
      },
      "call": {
        "type": "http",
        "method": "GET",
        "urlTemplate": "/api/public/pools/health",
        "auth": {
          "kind": "none"
        }
      },
      "risk": "read",
      "description": "Probes the indexer and the cache rather than reporting that the process is alive. Answers 503 when the indexer is unreachable, because every pool figure comes from it. Public, no key.",
      "returns": "An object with ok, surface, version, dependencies.",
      "relations": [
        {
          "type": "pairs_with",
          "target": "get_pools_search",
          "reason": "same resource: pools",
          "weight": 0.3
        },
        {
          "type": "pairs_with",
          "target": "get_pools",
          "reason": "same resource: pools",
          "weight": 0.3
        },
        {
          "type": "pairs_with",
          "target": "get_pools_liquidity",
          "reason": "same resource: pools",
          "weight": 0.3
        },
        {
          "type": "pairs_with",
          "target": "get_pools_volume",
          "reason": "same resource: pools",
          "weight": 0.3
        }
      ]

{
  "toolDictionary": "0.1",
  "id": "pool-scout",
  "title": "Pool Scout — liquidity pools",
  "summary": "Liquidity-pool due diligence for one (chain, pool): how deep it is, whether the liquidity can leave, who trades it, and what a provider earns.",
  "version": 1,
  "generatedAt": "2026-09-16T00:00:00.000Z",
  "index": {
    "nodes": [
      {
        "path": "pools",
        "title": "Pools",
        "summary": "One pool, one question at a time. Every tool takes the same (chain, pool) pair except search, which is how you find the pool in the first place.",
        "sampleQueries": [
          "find the main pool for a token",
          "can the liquidity be pulled",
          "how much volume did the pool do today",
          "what would i earn providing liquidity"
        ],
        "examples": [
          "get_pools",
          "get_pools_apr",
          "get_pools_liquidity"
        ],
        "children": [
          {
            "path": "pools/status",

      "call": {
        "type": "http",
        "method": "GET",
        "urlTemplate": "/api/public/pools/{chain}/{pool}/liquidity"
      },
      "risk": "read",
      "description": "Reserves and TVL, plus the share of LP tokens that is locked or burned. A pool whose LP is neither can be drained by whoever holds the LP tokens.",
      "returns": "An object with tvlUsd, reserves, lpSupply, lockedPct, burnedPct, change24hPct.",

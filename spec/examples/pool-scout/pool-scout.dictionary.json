    {
      "name": "get_pools_liquidity",
      "title": "Liquidity and lock status",
      "summary": "Reserves and TVL, plus how much of the LP is locked or burned — the figure that says whether the liquidity can be pulled.",
      "path": "pools",
      "keywords": [
        "liquidity",
        "chain",
        "depth",
        "leave",
        "rug",
        "rugpull",
        "can liquidity be pulled",
        "lp locked",
        "lp burned",
        "locked",
        "burned",
        "reserves",
        "tvl"
      ],
      "input": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "solana",
              "ethereum",
              "base",
              "bsc"
            ],
            "description": "Chain slug."
          },
          "pool": {
            "type": "string",
            "minLength": 20,
            "maxLength": 64,

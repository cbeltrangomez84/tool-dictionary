{
  "openapi": "3.0.0",
  "info": {
    "title": "Pool Scout",
    "version": "1.4.0",
    "description": "Liquidity-pool data for `(chain, pool)`: **overview**, **liquidity**, **volume**, **swaps**, **providers** and **yield**, one resource per concern.\n\n### Reading these docs is open; calling an endpoint is not\nEvery data endpoint requires an `x-scout-key` header.\n\n### `null` means \"no data\"\nEvery field is always present; `null` says the venue does not report it. A real `0` is a different statement from `null` and the two are never collapsed.\n\n### Chains\n`solana`, `ethereum`, `base`, `bsc`."
  },
  "servers": [
    {
      "url": "http://localhost:4020"
    }
  ],
  "tags": [
    {
      "name": "pools"
    }
  ],
  "components": {
    "securitySchemes": {
      "scoutKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-scout-key",
        "description": "Issued per project in the Pool Scout console."
      }
    }
  },
  "security": [
    {
      "scoutKey": []
    }
  ],
  "paths": {
    "/api/public/pools/health": {
      "get": {
        "summary": "Pool data surface health check",
        "tags": [
          "pools"
        ],
        "description": "Probes the indexer and the cache rather than reporting that the process is alive. Answers 503 when the indexer is unreachable, because every pool figure comes from it. Public, no key.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "surface",
                    "version",
                    "dependencies"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "description": "False when a dependency is down."
                    },
                    "surface": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "dependencies": {
                      "type": "object",
                      "required": [
                        "indexer",
                        "cache"
                      ],
                      "properties": {
                        "indexer": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ],
                          "description": "The chain indexer that feeds swaps and reserves."
                        },
                        "cache": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "surface",
                    "version",
                    "dependencies"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "description": "False when a dependency is down."
                    },
                    "surface": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "dependencies": {
                      "type": "object",
                      "required": [
                        "indexer",
                        "cache"
                      ],
                      "properties": {
                        "indexer": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ],
                          "description": "The chain indexer that feeds swaps and reserves."
                        },
                        "cache": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/public/pools/search": {
      "get": {
        "summary": "Find the pools a token trades in, ranked by liquidity, optionally on one chain",
        "tags": [
          "pools"
        ],
        "description": "Matches on token symbol, token name or token address. Returns the most liquid pools first so the first result is the one a trader would use.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Symbol, name or token address.",
            "schema": {
              "type": "string",
              "minLength": 2
            }
          },
          {
            "name": "chain",
            "in": "query",
            "required": false,
            "description": "Restrict to one chain.",
            "schema": {
              "type": "string",
              "enum": [
                "solana",
                "ethereum",
                "base",
                "bsc"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            }
          },
          {
            "name": "x-scout-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "results",
                    "total"
                  ],
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "pool",
                          "chain",
                          "dex",
                          "pair",
                          "tvlUsd",
                          "volume24hUsd"
                        ],
                        "properties": {
                          "pool": {
                            "type": "string",
                            "description": "Pool address."
                          },
                          "chain": {
                            "type": "string",
                            "description": "Chain slug."
                          },
                          "dex": {
                            "type": "string",
                            "description": "Venue."
                          },
                          "pair": {
                            "type": "string",
                            "description": "BASE/QUOTE."
                          },
                          "tvlUsd": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "description": "Total value locked, USD."
                          },
                          "volume24hUsd": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "description": "24h volume, USD."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "total": {
                      "type": "integer",
                      "description": "Number of pools matching before the limit was applied."
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/public/pools/{chain}/{pool}": {
      "get": {
        "summary": "Pool overview: venue, pair, fee tier, age, TVL and the price the reserves imply",
        "tags": [
          "pools"
        ],
        "description": "The one call that identifies a pool. Every other resource under this path assumes you already know which pool you mean.",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "required": true,
            "description": "Chain slug.",
            "schema": {
              "type": "string",
              "enum": [
                "solana",
                "ethereum",
                "base",
                "bsc"
              ]
            }
          },
          {
            "name": "pool",
            "in": "path",
            "required": true,
            "description": "Pool address (the pair contract, or the AMM account on Solana).",
            "schema": {
              "type": "string",
              "minLength": 20,
              "maxLength": 64
            }
          },
          {
            "name": "x-scout-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "pool",
                    "chain",
                    "dex",
                    "version",
                    "pair",
                    "feeTierBps",
                    "createdAt",
                    "tvlUsd",
                    "priceUsd"
                  ],
                  "properties": {
                    "pool": {
                      "type": "string",
                      "description": "Pool address as supplied."
                    },
                    "chain": {
                      "type": "string",
                      "description": "Chain slug."
                    },
                    "dex": {
                      "type": "string",
                      "description": "Venue the pool lives on, e.g. uniswap-v3, raydium, pancakeswap."
                    },
                    "version": {
                      "type": "string",
                      "description": "AMM version or program name."
                    },
                    "pair": {
                      "type": "object",
                      "required": [
                        "base",
                        "quote"
                      ],
                      "properties": {
                        "base": {
                          "type": "object",
                          "required": [
                            "address",
                            "symbol",
                            "decimals"
                          ],
                          "properties": {
                            "address": {
                              "type": "string",
                              "description": "Token address."
                            },
                            "symbol": {
                              "type": "string",
                              "description": "Ticker."
                            },
                            "decimals": {
                              "type": "integer",
                              "description": "Token decimals."
                            }
                          },
                          "additionalProperties": false
                        },
                        "quote": {
                          "type": "object",
                          "required": [
                            "address",
                            "symbol",
                            "decimals"
                          ],
                          "properties": {
                            "address": {
                              "type": "string",
                              "description": "Token address."
                            },
                            "symbol": {
                              "type": "string",
                              "description": "Ticker."
                            },
                            "decimals": {
                              "type": "integer",
                              "description": "Token decimals."
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "feeTierBps": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Swap fee in basis points; null when the venue has a single fixed fee it does not report."
                    },
                    "createdAt": {
                      "type": "string",
                      "description": "ISO-8601 time of the pool's first liquidity."
                    },
                    "tvlUsd": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Total value locked, USD."
                    },
                    "priceUsd": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Base token price implied by the reserves, USD."
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/public/pools/{chain}/{pool}/liquidity": {
      "get": {
        "summary": "Liquidity depth and how much of it can leave",
        "tags": [
          "pools"
        ],
        "description": "Reserves and TVL, plus the share of LP tokens that is locked or burned. A pool whose LP is neither can be drained by whoever holds the LP tokens.",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "required": true,
            "description": "Chain slug.",
            "schema": {
              "type": "string",
              "enum": [
                "solana",
                "ethereum",
                "base",
                "bsc"
              ]
            }
          },
          {
            "name": "pool",
            "in": "path",
            "required": true,
            "description": "Pool address (the pair contract, or the AMM account on Solana).",
            "schema": {
              "type": "string",
              "minLength": 20,
              "maxLength": 64
            }
          },
          {
            "name": "x-scout-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "tvlUsd",
                    "reserves",
                    "lpSupply",
                    "lockedPct",
                    "burnedPct",
                    "change24hPct"
                  ],
                  "properties": {
                    "tvlUsd": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Total value locked, USD."
                    },
                    "reserves": {
                      "type": "object",
                      "required": [
                        "base",
                        "quote"
                      ],
                      "properties": {
                        "base": {
                          "type": "number",
                          "description": "Base token reserve, in tokens."
                        },
                        "quote": {
                          "type": "number",
                          "description": "Quote token reserve, in tokens."
                        }
                      },
                      "additionalProperties": false
                    },
                    "lpSupply": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Total LP tokens outstanding; null on venues without LP tokens (concentrated liquidity)."
                    },
                    "lockedPct": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Share of LP tokens in a known locker contract, 0-100."
                    },
                    "burnedPct": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Share of LP tokens sent to a burn address, 0-100."
                    },
                    "change24hPct": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "TVL change over the last 24 hours, percent."
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/public/pools/{chain}/{pool}/volume": {
      "get": {
        "summary": "Swap volume, fees and trade counts over a window",
        "tags": [
          "pools"
        ],
        "description": "Buys and sells are counted relative to the base token of the pair.",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "required": true,
            "description": "Chain slug.",
            "schema": {
              "type": "string",
              "enum": [
                "solana",
                "ethereum",
                "base",
                "bsc"
              ]
            }
          },
          {
            "name": "pool",
            "in": "path",
            "required": true,
            "description": "Pool address (the pair contract, or the AMM account on Solana).",
            "schema": {
              "type": "string",
              "minLength": 20,
              "maxLength": 64
            }
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "description": "Window the figures cover.",
            "schema": {
              "type": "string",
              "enum": [
                "1h",
                "24h",
                "7d",
                "30d"
              ],
              "default": "24h"
            }
          },
          {
            "name": "x-scout-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "window",
                    "volumeUsd",
                    "feesUsd",
                    "trades",
                    "buys",
                    "sells",
                    "uniqueTraders"
                  ],
                  "properties": {
                    "window": {
                      "type": "string",
                      "enum": [
                        "1h",
                        "24h",
                        "7d",
                        "30d"
                      ],
                      "description": "Window the figures cover."
                    },
                    "volumeUsd": {
                      "type": "number",
                      "description": "Swap volume in the window, USD."
                    },
                    "feesUsd": {
                      "type": "number",
                      "description": "Fees earned by liquidity providers in the window, USD."
                    },
                    "trades": {
                      "type": "integer",
                      "description": "Number of swaps in the window."
                    },
                    "buys": {
                      "type": "integer",
                      "description": "Swaps that bought the base token."
                    },
                    "sells": {
                      "type": "integer",
                      "description": "Swaps that sold the base token."
                    },
                    "uniqueTraders": {
                      "type": "integer",
                      "description": "Distinct wallets that swapped."
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/public/pools/{chain}/{pool}/swaps": {
      "get": {
        "summary": "Recent swaps in a pool, newest first, with the wallet behind each one",
        "tags": [
          "pools"
        ],
        "description": "Paged with an opaque cursor. Sides are relative to the base token.",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "required": true,
            "description": "Chain slug.",
            "schema": {
              "type": "string",
              "enum": [
                "solana",
                "ethereum",
                "base",
                "bsc"
              ]
            }
          },
          {
            "name": "pool",
            "in": "path",
            "required": true,
            "description": "Pool address (the pair contract, or the AMM account on Solana).",
            "schema": {
              "type": "string",
              "minLength": 20,
              "maxLength": 64
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "From a previous response.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-scout-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "pool",
                    "swaps",
                    "nextCursor"
                  ],
                  "properties": {
                    "pool": {
                      "type": "string",
                      "description": "Pool address."
                    },
                    "swaps": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "txHash",
                          "at",
                          "side",
                          "amountBase",
                          "amountQuote",
                          "amountUsd",
                          "priceUsd",
                          "trader"
                        ],
                        "properties": {
                          "txHash": {
                            "type": "string",
                            "description": "Transaction hash / signature."
                          },
                          "at": {
                            "type": "string",
                            "description": "ISO-8601 block time."
                          },
                          "side": {
                            "type": "string",
                            "enum": [
                              "buy",
                              "sell"
                            ],
                            "description": "Relative to the base token."
                          },
                          "amountBase": {
                            "type": "number",
                            "description": "Base tokens moved."
                          },
                          "amountQuote": {
                            "type": "number",
                            "description": "Quote tokens moved."
                          },
                          "amountUsd": {
                            "type": "number",
                            "description": "Trade size, USD."
                          },
                          "priceUsd": {
                            "type": "number",
                            "description": "Execution price of the base token, USD."
                          },
                          "trader": {
                            "type": "string",
                            "description": "Wallet that sent the swap."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Pass back as `cursor` for the next page."
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/public/pools/{chain}/{pool}/providers": {
      "get": {
        "summary": "Who provides the liquidity and how concentrated it is",
        "tags": [
          "pools"
        ],
        "description": "Positions by wallet, largest first, with the share of the pool each one holds.",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "required": true,
            "description": "Chain slug.",
            "schema": {
              "type": "string",
              "enum": [
                "solana",
                "ethereum",
                "base",
                "bsc"
              ]
            }
          },
          {
            "name": "pool",
            "in": "path",
            "required": true,
            "description": "Pool address (the pair contract, or the AMM account on Solana).",
            "schema": {
              "type": "string",
              "minLength": 20,
              "maxLength": 64
            }
          },
          {
            "name": "x-scout-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "providers",
                    "count",
                    "top10Pct"
                  ],
                  "properties": {
                    "providers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "wallet",
                          "sharePct",
                          "valueUsd",
                          "since"
                        ],
                        "properties": {
                          "wallet": {
                            "type": "string",
                            "description": "Liquidity provider wallet."
                          },
                          "sharePct": {
                            "type": "number",
                            "description": "Share of the pool's liquidity, 0-100."
                          },
                          "valueUsd": {
                            "type": "number",
                            "description": "USD value of the position."
                          },
                          "since": {
                            "type": "string",
                            "description": "ISO-8601 time the position was opened."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "count": {
                      "type": "integer",
                      "description": "Total number of providers."
                    },
                    "top10Pct": {
                      "type": "number",
                      "description": "Share of liquidity held by the ten largest providers, 0-100."
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/public/pools/{chain}/{pool}/apr": {
      "get": {
        "summary": "Fee and incentive yield a liquidity provider would earn in this pool",
        "tags": [
          "pools"
        ],
        "description": "Annualised from the last seven days of fees against current TVL. An estimate, not a promise: it assumes volume and TVL stay where they are.",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "required": true,
            "description": "Chain slug.",
            "schema": {
              "type": "string",
              "enum": [
                "solana",
                "ethereum",
                "base",
                "bsc"
              ]
            }
          },
          {
            "name": "pool",
            "in": "path",
            "required": true,
            "description": "Pool address (the pair contract, or the AMM account on Solana).",
            "schema": {
              "type": "string",
              "minLength": 20,
              "maxLength": 64
            }
          },
          {
            "name": "x-scout-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "feeApr",
                    "incentiveApr",
                    "totalApr",
                    "basis"
                  ],
                  "properties": {
                    "feeApr": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Annualised fee yield for a full-range position, percent, from the last 7 days of fees."
                    },
                    "incentiveApr": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Annualised yield from venue incentives on top of fees, percent; null when there are none."
                    },
                    "totalApr": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "feeApr plus incentiveApr."
                    },
                    "basis": {
                      "type": "string",
                      "description": "What the estimate was computed from, e.g. '7d fees / current TVL'."
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
